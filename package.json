{
  "description": "خطّي — منصة خطوط النقل (ويب PWA + موبايل عبر Capacitor)",
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "leaflet": "1.9.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "name": "khatti",
  "private": true,
  "scripts": {
    "mobile:sync": "npm run web:pack && npx cap sync",
    "web:pack": "node scripts/pack-www.js",
    "test:unit": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test": "npm run typecheck && npm run web:pack && npm run test:unit && npm run test:server && npm run test:browser && npm run test:server-browser",
    "dev:server": "npm run web:pack && tsx server/main.ts",
    "auth:operator": "tsx server/operator.ts",
    "typecheck": "tsc",
    "test:server": "tsx --test --test-concurrency=1 tests/server/*.test.ts",
    "test:server-browser": "npm run web:pack && playwright test --config playwright.server.config.js"
  },
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}
